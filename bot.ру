@bot.message_handler(content_types=['text'])
def download_music(message):
    query = message.text.strip()
    bot.send_message(message.chat.id, "🔎 Ищу и скачиваю трек...")
    
    # Настройки для yt-dlp
    ydl_opts = {
        'format': 'bestaudio/best',
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'mp3',
            'preferredquality': '192',
        }],
        'outtmpl': f'downloads/{message.chat.id}_%(title)s.%(ext)s',
        'quiet': True,
    }
    
    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            # Ищем по названию или скачиваем по ссылке
            info = ydl.extract_info(f"ytsearch1:{query}", download=True)
            video = info['entries'][0]
            file_path = ydl.prepare_filename(video)
            # Меняем расширение на .mp3, так как yt-dlp его конвертирует
            mp3_path = file_path.rsplit('.', 1)[0] + '.mp3'
            
            with open(mp3_path, 'rb') as audio:
                bot.send_audio(message.chat.id, audio, title=video.get('title'), performer=video.get('uploader'))
            
            # Удаляем файл после отправки, чтобы не забивать память
            os.remove(mp3_path)
    except Exception as e:
        bot.send_message(message.chat.id, f"😔 Не удалось скачать трек. Попробуйте другой запрос или ссылку. Ошибка: {str(e)[:100]}")

bot.infinity_polling()